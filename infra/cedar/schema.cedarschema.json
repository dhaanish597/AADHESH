{
  "Aadesh": {
    "entityTypes": {
      "Principal": {
        "shape": {
          "type": "Record",
          "attributes": {
            "role": { "type": "String", "required": true },
            "assignedSite": { "type": "String", "required": false }
          }
        }
      },
      "Worker": {
        "shape": {
          "type": "Record",
          "attributes": {
            "workerId": { "type": "String", "required": true },
            "siteId": { "type": "String", "required": true }
          }
        }
      },
      "Site": {
        "shape": {
          "type": "Record",
          "attributes": {
            "siteId": { "type": "String", "required": true }
          }
        }
      },
      "StandingOrderExecution": {
        "shape": {
          "type": "Record",
          "attributes": {
            "executionId": { "type": "String", "required": true },
            "siteId": { "type": "String", "required": true }
          }
        }
      },
      "Parchi": {
        "shape": {
          "type": "Record",
          "attributes": {
            "worker": { "type": "Entity", "name": "Principal", "required": true },
            "siteId": { "type": "String", "required": true },
            "state": { "type": "String", "required": true },
            "execution": {
              "type": "Entity",
              "name": "StandingOrderExecution",
              "required": false
            }
          }
        }
      },
      "ClaimAssistanceContext": {
        "shape": {
          "type": "Record",
          "attributes": {
            "worker": { "type": "Entity", "name": "Worker", "required": true },
            "facilitator": { "type": "Entity", "name": "Principal", "required": true },
            "parchi": { "type": "Entity", "name": "Parchi", "required": true },
            "consentGranted": { "type": "Boolean", "required": true },
            "grantedAt": { "type": "Long", "required": true },
            "expiresAt": { "type": "Long", "required": true },
            "revokedAt": { "type": "Long", "required": false }
          }
        }
      }
    },
    "actions": {
      "IssueHalt": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["Site"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      },
      "ViewSiteExecution": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["Site"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      },
      "CreateStandingOrder": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["Site"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      },
      "AcknowledgeOwnParchi": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["Parchi"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      },
      "ViewParchi": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["Parchi"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      },
      "AssistClaim": {
        "appliesTo": {
          "principalTypes": ["Principal"],
          "resourceTypes": ["ClaimAssistanceContext"],
          "context": {
            "type": "Record",
            "attributes": { "now": { "type": "Long", "required": true } }
          }
        }
      }
    }
  }
}
