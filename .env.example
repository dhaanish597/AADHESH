# Aadesh — environment variable definitions
#
# Copy to `.env` and fill in. Nothing in this file is a secret; `.env` is gitignored.
# Every variable has a safe default that keeps Aadesh offline and deterministic.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# One of: test | local | aws
# `AllowAllTestOnly` authorization REFUSES to construct unless this is exactly "test".
AADESH_ENV=local

# ---------------------------------------------------------------------------
# AQI provider  (port: AqiProvider)
# ---------------------------------------------------------------------------
# fixture | openaq | replay
#   fixture : synthetic placeholder readings. Stamped provenance=SYNTHETIC.
#   openaq  : live OpenAQ API.           Stamped provenance=MEASURED.
#   replay  : recorded real readings.    Stamped provenance=REPLAY.
AADESH_AQI_PROVIDER=fixture
AADESH_AQI_FIXTURE_PATH=fixtures/readings/placeholder_readings.json

# OpenAQ v3 requires an API key. Leave blank while AADESH_AQI_PROVIDER=fixture.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# CPCB station this site is nearest to. CPCB is the cited authority; OpenAQ is the transport.
AADESH_STATION_ID=
# A reading older than this is flagged stale and must be labelled in the UI.
AADESH_READING_STALENESS_SECONDS=5400

# ---------------------------------------------------------------------------
# Corpus  (ports: RulesCorpus, SourceDocumentStore, InvokedStageSource)
# ---------------------------------------------------------------------------
# local | s3
AADESH_CORPUS_BACKEND=local
AADESH_CORPUS_PATH=corpus
# S3 bucket holding the exact downloaded CAQM order bytes, keyed by sha256.
AADESH_SOURCE_BUCKET=

# ---------------------------------------------------------------------------
# Authorization  (port: AuthorizationProvider)
# ---------------------------------------------------------------------------
# cedar | allow_all_test_only
# `allow_all_test_only` is rejected at construction unless AADESH_ENV=test.
AADESH_AUTHZ_BACKEND=cedar
AADESH_CEDAR_POLICY_PATH=infra/cedar/policies.cedar
AADESH_CEDAR_DENIALS_PATH=infra/cedar/denials.json

# ---------------------------------------------------------------------------
# Explanation  (port: ExplanationProvider) — OUTSIDE the enforcement path
# ---------------------------------------------------------------------------
# deterministic | strands_bedrock
# `deterministic` is always correct and always available. Bedrock only ever rephrases
# an already-computed result, and a contract violation falls back to deterministic.
AADESH_EXPLAIN_BACKEND=deterministic
# Bedrock model access must be enabled in us-east-1 before this works.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
AADESH_EXPLAIN_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Persistence  (port: ParchiStore)
# ---------------------------------------------------------------------------
# memory | dynamodb
AADESH_STORE_BACKEND=memory
AADESH_TABLE_READINGS=aadesh-readings
AADESH_TABLE_PARCHIS=aadesh-parchis
AADESH_TABLE_STANDING_ORDERS=aadesh-standing-orders
AADESH_TABLE_SITES=aadesh-sites

# ---------------------------------------------------------------------------
# Optional deep verification  (`make verify --with-index`)
# ---------------------------------------------------------------------------
AADESH_OPENSEARCH_URL=http://localhost:9200
AADESH_OPENSEARCH_INDEX=aadesh-corpus-pages

# ---------------------------------------------------------------------------
# AWS / LocalStack  (opt-in integration path only)
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
# Point at LocalStack for `make test-integration`; leave blank for real AWS.
AWS_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Signs QR handoff tokens. Generate per environment; never reuse the example value.
AADESH_QR_SIGNING_SECRET=change-me-not-a-real-secret
AADESH_QR_TOKEN_TTL_SECONDS=86400
