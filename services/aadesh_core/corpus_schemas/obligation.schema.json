{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aadesh.local/schemas/obligation.schema.json",
  "title": "Construction obligation: applicability and compliance with cited predicates",
  "description": "Every decision node and action names supporting evidence. The original primary citation is preserved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "obligation_id",
    "entity_types",
    "triggers_at_stage",
    "label",
    "source_doc",
    "page",
    "quote",
    "consequence",
    "applicability",
    "requirement",
    "required_action",
    "evidence",
    "stage_evidence",
    "continuation_evidence",
    "action_evidence"
  ],
  "properties": {
    "obligation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case id, e.g. grap3-cnd-dust-01."
    },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "construction_site"
      },
      "description": "Scope is deliberately ONE entity type. Adding another is out of scope."
    },
    "triggers_at_stage": {
      "type": "integer",
      "minimum": 1,
      "description": "The GRAP stage ordinal at which this obligation begins to apply. No maximum is encoded here: which stages exist is declared by the corpus, not by this schema or by application code."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Short human label. May be editorial, because it is never the legal basis for anything. The quote is."
    },
    "source_doc": {
      "type": "string",
      "minLength": 1,
      "description": "doc_id of an entry in corpus/sources/manifest.json. Must exist or verification fails."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "1-indexed page of the source document on which `quote` appears."
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "description": "VERBATIM text from the cited page. `make verify` re-checks this string appears in the extracted page text. A paraphrase breaks verification, which is the point."
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues_parchi"
      ],
      "properties": {
        "issues_parchi": {
          "type": "boolean",
          "description": "Whether triggering this obligation opens a parchi for each rostered worker."
        },
        "worker_entitlement_ref": {
          "type": "string",
          "description": "entitlement_id this obligation routes a displaced worker to. Optional: an obligation may halt work without a separately cited entitlement."
        }
      }
    },
    "applicability": {
      "$ref": "#/$defs/predicate"
    },
    "requirement": {
      "$ref": "#/$defs/predicate"
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!clause$)[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/citation"
      }
    },
    "stage_evidence": {
      "type": "string",
      "minLength": 1
    },
    "continuation_evidence": {
      "type": "string",
      "minLength": 1
    },
    "action_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clarification_when": {
      "$ref": "#/$defs/predicate"
    },
    "clarification": {
      "type": "string",
      "minLength": 1
    }
  },
  "dependentRequired": {
    "clarification_when": [
      "clarification"
    ],
    "clarification": [
      "clarification_when"
    ]
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_doc",
        "page",
        "quote"
      ],
      "properties": {
        "source_doc": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "operator",
            "value",
            "evidence"
          ],
          "properties": {
            "field": {
              "enum": [
                "in_ncr",
                "plot_size_sqm",
                "registered_on_state_portal",
                "remote_monitoring_requirements_met",
                "activity_type",
                "activity_in_progress",
                "is_minor_indoor_repair",
                "project_category",
                "ancillary_to_category",
                "dust_mitigation_compliant",
                "cd_waste_management_compliant",
                "commission_directions_compliant"
              ]
            },
            "operator": {
              "enum": [
                "eq",
                "gte",
                "in",
                "not_in"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "gte"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "in",
                      "not_in"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "eq"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "conditions",
            "evidence"
          ],
          "properties": {
            "operator": {
              "enum": [
                "and",
                "or"
              ]
            },
            "conditions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
